# Copy to key.properties and fill in. key.properties is NOT committed.
#
# Generate the upload keystore first (see docs/RELEASING.md):
#
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias upload
#
# storeFile is resolved relative to the android/app directory, so an absolute
# path outside the repository is the safest choice.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=C:/Users/paulj/keys/kylesvoice-upload-keystore.jks
