# Normalise line endings so contributors on Windows, macOS and Linux do not
# produce whole-file diffs. Text is stored LF in the repository and checked out
# native on each platform.
* text=auto eol=lf

# Windows-only tooling that must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Gradle wrapper.
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary assets: never munge.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.m4a binary
*.wav binary
*.ogg binary
*.jks binary
*.keystore binary
*.zip binary
*.obz binary
*.kvz binary
