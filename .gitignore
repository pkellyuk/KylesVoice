# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
*.iml

# Android
.gradle/
local.properties
captures/

# Signing credentials. Never commit these: key.properties names a keystore and
# holds its passwords, and the keystore itself is what proves a build came from
# us. See docs/RELEASING.md.
key.properties
**/key.properties
*.jks
*.keystore

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Spike artefacts: capture data and screenshots are reproducible, and are
# pulled from a device rather than authored. Real capture sessions worth
# keeping should be committed deliberately under docs/, not swept up by
# accident.
tools/touch_spike/captures/
tools/touch_spike/emulator_capture.png
*.png.tmp

# Real capture data is committed deliberately under docs/captures/ as evidence
# and as fixtures for the resolver. Only the working pull directory is ignored.
!docs/captures/*.csv

# App build output
app/*.png
tools/touch_spike/*.png
